<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="250dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="20dp"
                android:background="@drawable/pic_motivation"/>

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_card"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/btnProfile"
                style="@style/SettingsItemStyle">
                <ImageView
                    android:src="@drawable/ic_person"
                    style="@style/SettingsIconStyle"
                    android:layout_marginLeft="15dp"/>
                <TextView
                    android:text="Hồ sơ của bạn"
                    style="@style/SettingsTextStyle" />
            </LinearLayout>

            <View style="@style/DividerStyle" />

            <LinearLayout
                android:id="@+id/btnChangePassword"
                style="@style/SettingsItemStyle">
                <ImageView
                    android:src="@drawable/ic_lock"
                    style="@style/SettingsIconStyle"
                    android:layout_marginLeft="15dp"/>
                <TextView
                    android:text="Đổi mật khẩu"
                    style="@style/SettingsTextStyle" />
            </LinearLayout>

            <View style="@style/DividerStyle" />

            <LinearLayout
                android:id="@+id/btnSendAlert"
                style="@style/SettingsItemStyle">
                <ImageView
                    android:src="@drawable/ic_notifications"
                    style="@style/SettingsIconStyle"
                    android:layout_marginLeft="15dp"/>
                <TextView
                    android:text="Liên hệ khẩn cấp"
                    style="@style/SettingsTextStyle" />
            </LinearLayout>

            <View style="@style/DividerStyle" />

            <LinearLayout
                android:id="@+id/btnInfoApp"
                style="@style/SettingsItemStyle">
                <ImageView
                    android:src="@drawable/ic_info"
                    style="@style/SettingsIconStyle"
                    android:layout_marginLeft="15dp"/>
                <TextView
                    android:text="Thông tin phần mềm"
                    style="@style/SettingsTextStyle" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:text="Đăng xuất"
            android:textColor="#FF5252"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="20dp"
            app:strokeColor="#FF5252"
            app:strokeWidth="1dp" />

    </LinearLayout>
</ScrollView>